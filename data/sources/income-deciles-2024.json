        "note": {
          "tjt-henkiloita": [
            "Asuntoväestö, henkilöä. Asuntoväestöön kuuluvat  vuoden lopussa varsinaisissa asunnoissa vakinaisesti asuvat henkilöt. Laitoksissa vakinaisesti kirjoilla olevat, asuntoloissa ja ulkomailla asuvat sekä asunnottomat henkilöt eivät kuulu asuntoväestöön."
          ],
          "modoecd_mean": [
            "Eurostat-asteikko (OECD:n muunnettu asteikko), jossa kotitalouden ensimmäinen aikuinen saa painon 1, muut yli 13-vuotiaat saavat painon 0,5 ja lapset saavat painon 0,3 (0-13-vuotiaat)."
          ],
          "tjt-ostu": [
            "Osinkotulot kattavat osingot julkisesti ja ei-julkisesti noteeratuista yhtiöistä,  osinkotulot yhtymistä, osinkotulot ulkomailta, osuuskuntien ylijäämät sekä sijoitusrahastojen voitto-osuudet.\r\nOsinkotulot sisältävät verovapaan osuuden osinkotuloista."
          ],
          "tjt-myvo": [
            "Myyntivoitot = realisoidut luovutusvoitot - luovutustappiot (negatiiviset arvot on nollattu). Sisältää veronalaiset luovutusvoitot sekä verovapaan luovutusvoiton, kun  luovutushinnat olivat alle 1000 euroa."
          ],
          "saatusi": [
            "Saadut tulonsiirrot (alaerät ESSPROS-luokituksen mukaisesti)"
          ],
          "tjt-saira": [
            "Sairausajan toimeentuloturva sisältää mm. sairaus-, tartunta- ja tapaturmapäivärahat."
          ],
          "tjt-vamtyoky": [
            "Toimintarajoitteisuuteen liittyvät tuet sisältävät mm. työkyvyttömyyseläkkeet, kuntoutusrahan, vammaistuen sekä sotilasvammakorvaukset."
          ],
          "tjt-vanel": [
            "Vanhuuden turva sisältää kansaneläkkeet,  työeläkkeet ja takuueläkkeet vanhuuseläkkeenä."
          ],
          "tjt-perav": [
            "Lapsiperheiden etuudet sisältävät mm. lapsilisät, vanhempainpäivärahat, kotihoidon tuen sekä vuodesta 2010 alkaen elatustuen."
          ],
          "tjt-tyoel": [
            "Työttömyysturva sisältää peruspäivärahan, työmarkkinatuen, ansiosidonnaiset työttömyyspäivärahat,  eläketuen, starttirahan, koulutustuen, aikuiskoulutustuen ja vuorottelukorvaukset."
          ],
          "tjt-asutu": [
            "Asumisen tuet sisältävät yleisen asumistuen, eläkkeensaajien asumistuen ja opintorahan asumislisän."
          ],
          "tjt-optuki": [
            "Opintoetuudet sisältävät veronalaiset opintorahat, ammattitutkintostipendit sekä apurahat ja opiskeluavustukset. Myös asevelvollisten päivärahat on sisällytetty opintoetuuksiin. Nostetut opintolainat eivät sisälly opintoetuuksiin."
          ],
          "tjt-muutuki": [
            "Muu toimeentuloturva sisältää toimeentulotuen, sotilasavustuksen, opintolainojen korkoavustuksen, veronalaisen lakkoavustuksen, rekisteripohjaisesti imputoidun saadun elatusavun ja 2024 alkaen vastaanottorahan."
          ],
          "tjt-ekvikturaha_mean": [
            "Asuntokunnan käytettävissä olevat rahatulot jaettuna kulutusyksiköillä (Eurostat-asteikko). Jokainen asuntokunnan jäsen saa tämän saman tulon (ns. ekvivalentin tulon)."
          ],
          "tjt-ekvikturaha_med": [
            "Ekvivalentti tulo eli asuntokunnan (tai kotitalouden) käytettävissä olevat rahatulot jaettuna kulutusyksiköillä (Eurostat-asteikko)  Jokainen asuntokunnan jäsen saa tämän saman tulon (ns. ekvivalentin tulon). Kun tilastoyksikkö on henkilö, ekvivalentti tulo kuvaa henkilön taloudellisen toimeentulon tasoa laajemmin kuin henkilökohtaiset tulot."
          ],
          "korotyht": [
            "Asuntokunnan korkomenot yhteensä. Muiden kuin asuntolainojen tietosisältö on muuttunut vuonna 2012, ks. Tilastokeskuksen velkaantumistilaston käsitteet ja määritelmät."
          ]
        },
